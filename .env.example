# V3 独立系统调用 V2 的 HTTP API，不连接 V2 数据库。
# 本地未配置时默认使用本项目内置的 /api/v2 适配器，生产环境请指向真实 V2 服务。
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
V2_API_BASE_URL=
V2_API_KEY=local-dev-v2-key
V2_API_TIMEOUT_MS=3500
V2_API_RETRY_COUNT=1
