DATABASE_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL=
NEON_DATABASE_URL=
NEON_POSTGRES_URL=
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# V3 独立系统调用 V2 的 HTTP API，不连接 V2 数据库。
# 本地未配置 V2_API_BASE_URL 时，默认调用独立 v2 项目：http://127.0.0.1:3001/api/v1
V2_API_BASE_URL=http://127.0.0.1:3001/api/v1
V2_LOCAL_PORT=3001
V2_API_KEY=local-dev-v2-key
V2_API_TIMEOUT_MS=3500
V2_API_RETRY_COUNT=1
